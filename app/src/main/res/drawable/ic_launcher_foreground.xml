        android:pathData="M38,42 L38,78 M48.7,42 L48.7,78 M59.3,42 L59.3,78 M70,42 L70,78"
        android:strokeColor="#8B93A7"
        android:strokeWidth="1.8" />

    <!-- 品丝（横线），第一根是琴枕，画粗一点 -->

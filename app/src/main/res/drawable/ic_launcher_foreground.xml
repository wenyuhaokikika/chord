        android:pathData="M38,51 L70,51 M38,60 L70,60 M38,69 L70,69 M38,78 L70,78"
        android:strokeColor="#8B93A7"
        android:strokeWidth="1.8" />
    <path
        android:pathData="M35,42 L73,42"
        android:strokeColor="#E7EAF0"
        android:strokeWidth="4"
        android:strokeLineCap="round" />

    <!-- 按弦点 -->
